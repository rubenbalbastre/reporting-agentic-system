# Shared
PROJECT_NAME=agentic-analytics-reporting
SHARED_DATA_PATH=./data/shared

# Backend
BACKEND_PORT=8000
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/reporting
LANGFUSE_HOST=http://langfuse-web:3000
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_BASE_URL="http://localhost:3002"

# Frontend
FRONTEND_PORT=3001
NEXT_PUBLIC_API_BASE=http://localhost:8000

# Worker
WORKER_PORT=8010

# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_ORG=org_... # optional

# Postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=reporting
POSTGRES_PORT=5432

# Langfuse (self-hosted v3)
LANGFUSE_NEXTAUTH_URL=http://localhost:3002
LANGFUSE_DATABASE_URL=postgresql://postgres:postgres@langfuse-postgres:5432/postgres
LANGFUSE_NEXTAUTH_SECRET=replace_with_secure_random_secret
LANGFUSE_SALT=replace_with_secure_random_salt
LANGFUSE_ENCRYPTION_KEY=replace_with_64_hex_chars_from_openssl_rand_hex_32
LANGFUSE_TELEMETRY_ENABLED=true
LANGFUSE_CLICKHOUSE_USER=clickhouse
LANGFUSE_CLICKHOUSE_PASSWORD=clickhouse
LANGFUSE_REDIS_AUTH=myredissecret
LANGFUSE_MINIO_ROOT_USER=minio
LANGFUSE_MINIO_ROOT_PASSWORD=miniosecret
